# Copy to .env on the machine running Flask. Use one app worker.
DATA_BACKEND=oracle
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=XEPDB1
ORACLE_USER=rescue
# Set this to your supplied password locally. Never commit credentials.
ORACLE_PASSWORD=
ORACLE_TABLE=MDRRMC_RECORDS
SECRET_KEY=replace-with-a-random-long-secret

LOGIN_USERNAME=RescueEchague
# Optional Werkzeug password hash to override the initial account password.
# LOGIN_PASSWORD_HASH=
# Set to 1 when serving over HTTPS.
SESSION_COOKIE_SECURE=0
